+#ifdef CONFIG_WIN32
+/* Windows file views are released with the RAMBlock after its RCU grace period. */
+RAMBlock *qemu_ram_alloc_from_file(ram_addr_t size, MemoryRegion *mr,
+                                 uint32_t ram_flags, const char *path,
+                                 off_t offset, Error **errp)
+{
+    HANDLE file, mapping;
+    LARGE_INTEGER length;
+    SYSTEM_INFO info;
+    uint64_t aligned, delta;
+    void *view;
+    int fd;
+    RAMBlock *block;
+    g_autofree gunichar2 *wide_path = NULL;
+
+    if (!size || offset < 0 || (size | offset) % qemu_real_host_page_size() ||
+        size > SIZE_MAX - (uint64_t)offset ||
+        !(ram_flags & RAM_SHARED) ||
+        (ram_flags & ~(RAM_SHARED | RAM_NAMED_FILE)) || mr->align) {
+        error_setg(errp, "Windows file RAM requires shared writable storage, "
+                         "default alignment and a bounded extent");
+        return NULL;
+    }
+    wide_path = g_utf8_to_utf16(path, -1, NULL, NULL, NULL);
+    if (!wide_path) {
+        error_setg(errp, "RAM file path is not valid UTF-8");
+        return NULL;
+    }
+    file = CreateFileW((LPCWSTR)wide_path, GENERIC_READ | GENERIC_WRITE,
+                       FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+                       OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (file == INVALID_HANDLE_VALUE) {
+        error_setg_win32(errp, GetLastError(), "Cannot open existing RAM file");
+        return NULL;
+    }
+    if (!GetFileSizeEx(file, &length) ||
+        (uint64_t)length.QuadPart < size + (uint64_t)offset) {
+        error_setg(errp, "Windows RAM file is smaller than requested extent");
+        CloseHandle(file);
+        return NULL;
+    }
+    GetSystemInfo(&info);
+    aligned = (uint64_t)offset & ~((uint64_t)info.dwAllocationGranularity - 1);
+    delta = (uint64_t)offset - aligned;
+    mapping = CreateFileMapping(file, NULL, PAGE_READWRITE, 0, 0, NULL);
+    if (!mapping) {
+        error_setg_win32(errp, GetLastError(), "Cannot create RAM file mapping");
+        CloseHandle(file);
+        return NULL;
+    }
+    view = MapViewOfFile(mapping, FILE_MAP_READ | FILE_MAP_WRITE,
+                         aligned >> 32, (DWORD)aligned, size + delta);
+    CloseHandle(mapping);
+    if (!view) {
+        error_setg_win32(errp, GetLastError(), "Cannot map RAM file view");
+        CloseHandle(file);
+        return NULL;
+    }
+    fd = _open_osfhandle((intptr_t)file, O_BINARY | O_RDWR);
+    if (fd < 0) {
+        error_setg_errno(errp, errno, "Cannot retain RAM file descriptor");
+        UnmapViewOfFile(view);
+        CloseHandle(file);
+        return NULL;
+    }
+    block = qemu_ram_alloc_internal(size, size, NULL, (char *)view + delta,
+                                    RAM_PREALLOC | RAM_SHARED, mr, errp);
+    if (!block) {
+        UnmapViewOfFile(view);
+        close(fd);
+        return NULL;
+    }
+    block->fd = fd;
+    block->fd_offset = offset;
+    block->flags |= RAM_NAMED_FILE;
+    block->win32_file_view = view;
+    return block;
+}
