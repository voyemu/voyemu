# Embed only public profile definitions, never their private OEM inputs.
file(GLOB voyemu_profile_files CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/../../profiles/*/profile.json")
list(SORT voyemu_profile_files)
set(voyemu_catalog "[")
set(voyemu_separator "")
foreach(source IN LISTS voyemu_profile_files)
    get_filename_component(directory "${source}" DIRECTORY)
    get_filename_component(id "${directory}" NAME)
    if(NOT id MATCHES "^[A-Za-z0-9][A-Za-z0-9_.-]*$")
        message(FATAL_ERROR "Invalid embedded profile id")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
    file(READ "${source}" definition)
    string(JSON schema GET "${definition}" schema)
    if(NOT schema EQUAL 1)
        message(FATAL_ERROR "Unsupported embedded profile schema")
    endif()
    string(JSON local ERROR_VARIABLE local_missing GET "${definition}" local)
    if(NOT local_missing AND local)
        continue()
    endif()
    string(JSON status ERROR_VARIABLE status_missing GET "${definition}" status)
    if(NOT status_missing AND NOT status STREQUAL "ready")
        continue()
    endif()
    # Tests select profiles by these lists, voyemu_profiles_<platform>_<board>, never by name.
    string(JSON platform ERROR_VARIABLE platform_missing GET "${definition}" platform)
    string(JSON board ERROR_VARIABLE board_missing GET "${definition}" board)
    if(platform_missing OR board_missing OR NOT platform MATCHES "^(qinggan09|qinggan11|passion)$" OR NOT board MATCHES "^(8155|nxp)$")
        message(FATAL_ERROR "Embedded profile ${id} requires platform qinggan09, qinggan11 or passion and board 8155 or nxp")
    endif()
    list(APPEND voyemu_profiles_${platform}_${board} "${id}")
    file(SHA256 "${source}" digest)
    string(APPEND voyemu_catalog "${voyemu_separator}{\"id\":\"${id}\",\"sha256\":\"${digest}\",\"definition\":${definition}}")
    set(voyemu_separator ",")
endforeach()
if(NOT voyemu_profile_files)
    message(FATAL_ERROR "At least one source profile required")
endif()
string(APPEND voyemu_catalog "]")
# The catalog is embedded deflated; byte initializers avoid compiler string-literal limits.
include("${CMAKE_CURRENT_LIST_DIR}/embedded_deflate.cmake")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/profile_catalog.json" "${voyemu_catalog}")
voyemu_deflate_initializer("${CMAKE_CURRENT_BINARY_DIR}/profile_catalog.json" "${CMAKE_CURRENT_BINARY_DIR}/profile_catalog.json.gz" voyemu_catalog_bytes voyemu_catalog_size)
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/profile_catalog.inc" "static constexpr unsigned char embedded_catalog_json[]={${voyemu_catalog_bytes}};\nstatic constexpr std::size_t embedded_catalog_json_size=${voyemu_catalog_size};\n")
